# Mise auth — environment configuration. NEVER commit a filled-in .env.
# All secrets are read from here; they are never hardcoded, logged, or returned.

# --- JWT ---------------------------------------------------------------------
# RS256 (preferred) or HS256 (minimum).
JWT_ALGORITHM=RS256

# For HS256: a single strong secret.
# JWT_SECRET=replace-with-a-long-random-secret

# For RS256: PEM key material (raw PEM or base64-encoded PEM both accepted).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Optional issuer/audience pinning (defaults: mise / mise-app).
# JWT_ISSUER=mise
# JWT_AUDIENCE=mise-app

# --- Session lifecycle -------------------------------------------------------
SESSION_EXPIRY_HOURS=8        # absolute token lifetime (one shift)
SESSION_TIMEOUT_MINUTES=30    # inactivity timeout

# --- Database ----------------------------------------------------------------
# Deploy only to AWS ap-southeast-* (AU data residency).
DB_CONNECTION_STRING=postgres://user:pass@host:5432/mise
# DB_APP_ROLE=mise_app        # least-privilege, FORCE-RLS role assumed per txn

# --- Claude answer synthesis (MIS-42) ----------------------------------------
# OPTIONAL. When unset, /api/chat composes answers deterministically from the
# top retrieved chunk. Set BOTH the key and an AU-resident base URL to enable
# persona-voiced Claude synthesis. The key is an operator/board-provisioned
# secret — never commit a real value.
#
# AU DATA RESIDENCY: ANTHROPIC_BASE_URL must point at an AU-resident endpoint
# (e.g. AWS Bedrock in ap-southeast-2 or an AU-region gateway). Synthesis stays
# OFF unless this is set, so questions are never sent to a non-AU endpoint.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://<au-resident-endpoint>
# ANTHROPIC_MODEL=claude-opus-4-7
# ANTHROPIC_MAX_TOKENS=1024

# --- Server ------------------------------------------------------------------
# PORT=3000
